      "actual": "Hola, Ada!",
      "passed": true
    },
    {
      "id": "unsupported_language_code",
      "description": "Unsupported language codes throw a descriptive error",
      "input": "{\"name\":\"Ada\",\"language\":\"unsupported_code\"}",
      "expected": "Error containing \"Unsupported language\"",
      "actual": "Error: Unsupported language 'unsupported_code'. Supported languages: en, es, fr, de",
      "passed": true
